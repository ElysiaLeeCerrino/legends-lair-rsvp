# Copy this file to .env for local testing and fill in your own values.
# Never upload .env or share tokens / private keys.

# Discord
DISCORD_TOKEN=put_your_discord_bot_token_here
CLIENT_ID=put_your_discord_application_id_here
GUILD_ID=put_your_discord_server_id_here
PORT=10000

# Google Calendar (optional — bot still works without these)
# Create a service account in Google Cloud, enable Calendar API,
# share your calendar with the service account email (Make changes to events),
# then paste the values from the JSON key file.
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/London
